# Fase 2: DATABASE_URL y CV_DATA_DIR son consumidas por migraciones/carga.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/v1
# Solo servidor: completar fuera de Git. Nunca usar prefijo VITE_ para credenciales.
DATABASE_URL=postgresql://usuario:COMPLETAR_LOCALMENTE@127.0.0.1:5432/credito_vecino
# Base exclusiva para integración; el nombre debe terminar en _test. Nunca usar la base de demo.
TEST_DATABASE_URL=postgresql://usuario:COMPLETAR_LOCALMENTE@127.0.0.1:5432/credito_vecino_fase2_test
CV_DATA_DIR=./datos/datos-proyecto-final
MCP_TRANSPORT=stdio
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0
# qwen3:8b en CPU tarda ~45 s por respuesta (fase 5); el primer uso además carga el modelo.
LLM_TIMEOUT_MS=180000
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=4
# Similitud coseno mínima (bge-m3) para considerar que un fragmento respalda la pregunta; calibrada en fase 5.
RAG_UMBRAL_SIMILITUD=0.5
CHAT_SESSION_MAX_TURNS=12
CHAT_SESSION_TTL_MINUTES=60
IDEMPOTENCY_RETENTION_DAYS=30
# Propuestas sin TTL de reloj: ligadas a sesión, corte y versión del crédito.
DEFAULT_SESSION_CUTOFF=2026-10-31
