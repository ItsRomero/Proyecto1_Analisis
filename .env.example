# Preparación contractual; los consumidores se implementan en las fases siguientes.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000/v1
# Solo servidor: completar fuera de Git. Nunca usar prefijo VITE_ para credenciales.
DATABASE_URL=postgresql://usuario:COMPLETAR_LOCALMENTE@127.0.0.1:5432/credito_vecino
CV_DATA_DIR=./datos/datos-proyecto-final
MCP_TRANSPORT=stdio
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0
LLM_TIMEOUT_MS=60000
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
RAG_TOP_K=4
CHAT_SESSION_MAX_TURNS=12
CHAT_SESSION_TTL_MINUTES=60
IDEMPOTENCY_RETENTION_DAYS=30
# Propuestas sin TTL de reloj: ligadas a sesión, corte y versión del crédito.
DEFAULT_SESSION_CUTOFF=2026-10-31
